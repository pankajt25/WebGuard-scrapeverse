# Copy this file to .env and fill in real values to switch to live mode.

# When true (default), the backend never calls Bright Data — it serves the
# seed data in data/seed.json and lets you trigger simulated runs and a
# simulated site-change/self-heal cycle from the dashboard.
DEMO_MODE=true

# Bright Data API token — https://brightdata.com/cp/setting/users
BRIGHT_DATA_API_TOKEN=

# Collector ID from Scraper Studio, starts with c_ — see scraper/SETUP.md
BRIGHT_DATA_COLLECTOR_ID=

# Base URL for the Bright Data API. Only change this if Bright Data tells you to.
BRIGHT_DATA_API_BASE=https://api.brightdata.com

# If true, a detected broken field triggers `scraper heal` AND auto-approves
# the fix immediately (no human review). If false (default, recommended),
# the backend calls heal and stops at the approval gate, logging the
# preview_result for a human to review via scraper/approve.
AUTO_APPROVE_HEALS=false

PORT=4000
